{
  "name": "domain-monitor/domain-monitor",
  "description": "WordPress plugin for monitoring domain health and continuity.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "DomainMonitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DomainMonitor\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite unit",
    "build": "bin/build.sh"
  },
  "config": {
    "allow-plugins": true,
    "sort-packages": true
  }
}
